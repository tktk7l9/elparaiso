# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# keyway pull -e <env> writes .env.development / .env.production; ignore every
# .env* so none of them can reach this public repository.
.env
.env.*
# wrangler local secrets
.dev.vars
.dev.vars.*

# vercel
.vercel

# Cloudflare Workers build output and local state
.open-next
.wrangler
