# Headers for responses served straight from Workers static assets (/_next/static,
# /images, favicon). Those never reach the Worker, so headers() in next.config.js does
# not apply to them. HTML keeps getting its headers from next.config.js.
# https://developers.cloudflare.com/workers/static-assets/headers/
/*
  X-Content-Type-Options: nosniff

# Build-hashed chunks never change under the same URL.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
