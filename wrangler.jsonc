/**
 * elparaiso — Cloudflare Workers config
 * https://developers.cloudflare.com/workers/framework-guides/web-apps/nextjs/
 *
 * Next.js is built with @opennextjs/cloudflare and runs on Workers.
 * Every route is prerendered, but requests go through the Worker so that headers() in next.config.js applies.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elparaiso",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-16",
  // Required to run Next.js. The date must be 2024-09-23 or later.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
